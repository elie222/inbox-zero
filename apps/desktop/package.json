{
  "name": "@inboxzero/desktop",
  "productName": "Inbox Zero",
  "private": true,
  "version": "0.1.0",
  "description": "Electron shell for the Inbox Zero web app",
  "author": "Inbox Zero",
  "type": "module",
  "main": "dist/main.js",
  "scripts": {
    "build": "node esbuild.config.mjs",
    "dev": "pnpm build && electron .",
    "start": "electron .",
    "dist": "pnpm build && electron-builder --publish never",
    "dist:mac": "pnpm build && electron-builder --mac --publish never",
    "dist:win": "pnpm build && electron-builder --win --publish never",
    "dist:linux": "pnpm build && electron-builder --linux dir --publish never",
    "test": "vitest run"
  },
  "devDependencies": {
    "@types/node": "24.10.1",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.4",
    "electron": "43.4.0",
    "electron-builder": "26.15.3",
    "esbuild": "0.28.2",
    "typescript": "6.0.3",
    "vitest": "4.1.10"
  },
  "dependencies": {
    "@inboxzero/mail-core": "workspace:*",
    "@inboxzero/mail-react": "workspace:*",
    "@inboxzero/mail-sqlite": "workspace:*",
    "@inboxzero/mail-ui": "workspace:*",
    "electron-updater": "6.8.9",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  }
}
