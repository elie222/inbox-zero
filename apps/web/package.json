{
  "name": "inbox-zero-ai",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "build": "node scripts/build-mcp-app.mjs && prisma migrate deploy && cross-env NODE_OPTIONS=--max_old_space_size=16384 next build && serwist build serwist.config.mjs",
    "build:ci": "node scripts/build-mcp-app.mjs && cross-env NODE_OPTIONS=--max_old_space_size=16384 next build && serwist build serwist.config.mjs",
    "check-client-redirects": "node scripts/check-client-redirects.js",
    "check-enums": "node scripts/check-enum-imports.js",
    "check-server-actions": "node scripts/check-server-action-exports.js",
    "check-test-fixtures": "tsx scripts/check-test-fixtures.ts",
    "dev": "cross-env NODE_OPTIONS=--max_old_space_size=6144 next dev --turbopack",
    "dev:e2e": "dotenv run -q -f .env.e2e -- cross-env NODE_OPTIONS=--max_old_space_size=6144 next dev --turbopack",
    "emulate:google": "pnpm emulate:seed && emulate --service google --seed .tmp/emulate.generated.json --port 4002",
    "emulate:microsoft": "pnpm emulate:seed && emulate --service microsoft --seed .tmp/emulate.generated.json --port 4003",
    "emulate:recall": "tsx scripts/run-recall-emulator.ts",
    "emulate:stripe": "tsx scripts/run-stripe-emulator.ts",
    "emulate:llm": "tsx scripts/run-llm-emulator.ts",
    "emulate:seed": "tsx scripts/write-emulate-seed.ts",
    "emulator:down": "node scripts/emulator/stack.mjs down",
    "emulator:up": "node scripts/emulator/stack.mjs up",
    "eval:ablate": "dotenv run -q --override -f .env.test -- tsx --tsconfig tsconfig.eval-script.json scripts/eval-ablate.ts",
    "eval:compare": "tsx --tsconfig tsconfig.eval-script.json scripts/eval-compare-runs.ts",
    "eval:pool-ablations": "tsx --tsconfig tsconfig.eval-script.json scripts/eval-pool-ablations.ts",
    "eval-report": "tsx scripts/eval-report/generate-eval-report.ts",
    "generate-llm-pricing": "tsx scripts/generate-llm-pricing.ts",
    "preinstall": "npx only-allow pnpm",
    "postinstall": "prisma generate",
    "lint": "biome check .",
    "prisma:migrate:e2e": "dotenv run -q -f .env.e2e -- prisma migrate deploy",
    "prisma:migrate:local": "dotenv run -q -f .env.local -- prisma migrate deploy",
    "start": "next start",
    "start:standalone": "node .next/standalone/server.js",
    "telegram:setup": "dotenv run -q -f .env.local -- tsx scripts/setup-telegram-bot.ts",
    "test": "cross-env RUN_AI_TESTS=false vitest",
    "test:playwright": "playwright test -c playwright.config.mjs",
    "test:playwright:emulated": "node __tests__/playwright/run-emulated-suite.mjs",
    "test:playwright:emulated:setup": "playwright test -c playwright.config.mjs --project=emulated-setup",
    "test-ai": "cross-env RUN_AI_TESTS=true vitest --run",
    "test-db": "cross-env RUN_DB_TESTS=true vitest --run --dir __tests__/db",
    "test-e2e": "cross-env RUN_E2E_TESTS=true vitest --run",
    "test-e2e:flows": "cross-env RUN_E2E_FLOW_TESTS=true vitest --run --dir __tests__/e2e/flows --no-file-parallelism",
    "test-integration": "cross-env RUN_INTEGRATION_TESTS=true vitest --run --dir __tests__/integration",
    "test:mail-loading": "node __tests__/playwright/mail-simulation/run.mjs"
  },
