{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "declaration": true,
    "declarationMap": false,
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "noEmit": false,
    "outDir": "dist",
    "rootDir": ".",
    "sourceMap": false,
    "types": ["node"]
  },
  "include": ["src/**/*.ts", "test-support/**/*.ts"],
  "exclude": ["src/**/*.test.ts"]
}
