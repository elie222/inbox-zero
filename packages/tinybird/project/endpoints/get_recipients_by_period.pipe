TOKEN "read pipes token" READ

NODE sent_emails
DESCRIPTION >
    Filter sent emails for user.

SQL >

%
    SELECT "to" FROM email
    WHERE sent = true AND draft = false AND ownerEmail = {{ String(ownerEmail) }}



NODE get_most_sent_to
DESCRIPTION >
    Get most active recipients for a given period of time.

SQL >

%
    SELECT "to", COUNT(*) as count FROM sent_emails
    GROUP BY "to"
    ORDER BY count DESC
    LIMIT {{ Int64(limit, 50) }}

TYPE endpoint


